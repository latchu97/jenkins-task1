pipeline {
  agent none

  triggers { githubPush() }

  environment {
    REPO_URL = "https://github.com/latchu97/jenkins-task1.git"
    CREDS    = "62ef1e9c-a975-4175-a0cb-217070776f9e"
    TEST_DIR = "C:\\deploy\\test"
    PROD_DIR = "C:\\deploy\\prod"
  }

  stages {
    stage('Deploy to TEST') {
      agent { label 'test' }
      steps {
        checkout([$class: 'GitSCM',
          branches: [[name: '*/develop']],
          userRemoteConfigs: [[url: env.REPO_URL, credentialsId: env.CREDS]]
        ])

        bat """
          echo Deploying to TEST...
          if not exist "%TEST_DIR%" mkdir "%TEST_DIR%"
          robocopy "%WORKSPACE%" "%TEST_DIR%" /MIR /XD ".git" /R:2 /W:2
          if %ERRORLEVEL% LEQ 7 (exit 0) else (exit %ERRORLEVEL%)
        """
      }
    }

    stage('Deploy to PROD (only if TEST success)') {
      agent { label 'prod' }
      steps {
        checkout([$class: 'GitSCM',
          branches: [[name: '*/develop']],
          userRemoteConfigs: [[url: env.REPO_URL, credentialsId: env.CREDS]]
        ])

        bat """
          echo Deploying to PROD...
          if not exist "%PROD_DIR%" mkdir "%PROD_DIR%"
          robocopy "%WORKSPACE%" "%PROD_DIR%" /MIR /XD ".git" /R:2 /W:2
          if %ERRORLEVEL% LEQ 7 (exit 0) else (exit %ERRORLEVEL%)
        """
      }
    }
  }
}
